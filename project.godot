config_version=5

[application]

config/name="MetroidGuy"
run/main_scene="uid://r432kmtahtq7"
config/features=PackedStringArray("4.6", "Forward Plus")
run/max_fps=100
config/icon="uid://dlensa8cw3sqg"

[audio]

buses/default_bus_layout="uid://ddqxxkufavcnc"

[autoload]

SceneManager="*uid://ceg47as2m6ckl"
SaveManager="*uid://cxxicq3a51lad"
Messages="*uid://bllhiixv81cxy"
PlayerHud="*uid://bdvhiqeqgao2"
Audio="*uid://bjwclvs35c2ba"
VisualEffects="*uid://cx3xbr8qu1r33"

[display]

