[sub_resource type="GDScript" id="GDScript_gjt4y"]
script/source = "extends Label

@onready var player_sensor: PlayerSensor = $\"../PlayerSensor\"
@onready var living_armor: Enemy = $\"..\"


func _physics_process(_delta: float) -> void:
	text = \"\"
	text = \"target = \"
	text += living_armor.blackboard.target.name if living_armor.blackboard.target else \"\"
	pass
"

